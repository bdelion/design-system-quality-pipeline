{
  "singleQuote": true,
  "semi": true,
  "trailingComma": "none",
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.md", "options": { "proseWrap": "preserve" } },
    { "files": ["*.yaml", "*.yml"], "options": { "singleQuote": false } }
  ]
}
