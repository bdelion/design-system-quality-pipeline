{
  "name": "design-system-quality-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub-first, read-only quality pipeline for Design Systems.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "collect": "tsx src/cli.ts collect",
    "validate": "tsx src/cli.ts validate",
    "analyze": "tsx src/cli.ts analyze",
    "snapshot": "tsx src/cli.ts snapshot",
    "dashboard": "tsx src/cli.ts dashboard",
    "pipeline": "tsx src/cli.ts pipeline",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^18.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}