GITHUB_TOKEN=
# Optional: use a GitHub Enterprise API endpoint.
GITHUB_API_URL=https://api.github.com
# Optional: use GitHub GraphQL to resolve manually linked pull requests.
GITHUB_GRAPHQL_URL=https://api.github.com/graphql
# Base URL used for links in the generated dashboard.
GITHUB_URL=https://github.com

# Anonymisation reproductible : conserver ces valeurs entre collectes.
ANONYMIZATION_SEED=dsqp-local-stable
ANON_GITHUB_OWNER=demo-design-system
# Nom source en majuscules, caractères non alphanumériques remplacés par _.
# Exemple pour un dépôt source « design-system-react » :
# ANON_REPO_DESIGN_SYSTEM_REACT=demo-react
# ANON_REPO_DESIGN_SYSTEM_CORE=demo-core
# ANON_REPO_DESIGN_SYSTEM_DOCS=demo-docs
# Attention : deux noms GitHub qui se normalisent de la même manière sont refusés.
# Le parcours fixture:prepare décale les dates de -365 jours ; pas de variable de réglage.

# Changer la graine d'exemple pour une graine privée avant de préparer des données réelles.
# Conserver la même graine entre collectes pour obtenir des alias stables.
# fixture:prepare réutilise sinon la graine privée capturée dans le RAW.
# Voir docs/08-implementation/guide-utilisation.md pour les recettes et les options.
# Catalogues privés : config/local/ ; captures réelles : data/local/.
